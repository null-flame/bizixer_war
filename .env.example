# Bizixer War Environment Configuration
# Copy this file to .env and fill in your values

# JWT Secret Key (REQUIRED)
# Use a strong, random string (at least 32 characters)
# You can generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
sec=your-very-secure-secret-key-here-change-this-in-production

# Database URL (Optional)
# Default: SQLite database file
# For production, you might want to use PostgreSQL or MySQL
# Examples:
# DATABASE_URL=sqlite+aiosqlite:///db.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost/dbname
# DATABASE_URL=mysql+aiomysql://user:password@localhost/dbname
DATABASE_URL=sqlite+aiosqlite:///db.db
