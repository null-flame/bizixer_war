# Bizixer War - Environment Configuration
# ======================================
# Copy this file to .env and fill in the required values

# JWT Secret Key (REQUIRED)
# Generate a strong secret key for JWT token signing
# You can use: openssl rand -hex 32
sec=your_super_secret_jwt_key_here_change_this_in_production

# Database URL (Optional - defaults to SQLite)
# For SQLite (default):
# DB_URL=sqlite+aiosqlite:///db.db

# For PostgreSQL:
# DB_URL=postgresql+asyncpg://user:password@localhost:5432/bizixer_war

# For MySQL:
# DB_URL=mysql+aiomysql://user:password@localhost:3306/bizixer_war

# Application Settings
# DEBUG=true
# APP_NAME="Bizixer War"

# Security Settings
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30
